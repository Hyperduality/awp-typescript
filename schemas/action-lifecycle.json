    "pending_approval": "pre-execution",
    "queued": "pre-execution",
    "accepted": "pre-execution",
    "executing": "execution",
    "cancelling": "execution",
    "rejected": "terminal",
    "completed": "terminal",
    "failed": "terminal",
    "preempted": "terminal",
    "cancelled": "terminal"
