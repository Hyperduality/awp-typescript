        "cancelled_by_agent",
        "e_stop",
        "safe_state",
        "session_closed",
        "world_reset",
        "transferred",
        "superseded"
      ]
    },
    {
      "from": "queued",
      "to": "accepted",
      "label": "group free"
    },
    {
      "from": "queued",
      "to": "rejected",
      "label": "deadline or re-check fails",
      "reasons": [
        "deadline_exceeded",
        "stale_intent",
        "forbidden",
        "envelope"
      ]
    },
    {
      "from": "queued",
      "to": "cancelled",
      "label": "cancel, e-stop, safe state, close, reset, transfer, superseded",
      "reasons": [
        "cancelled_by_agent",
        "e_stop",
        "safe_state",
        "session_closed",
        "world_reset",
        "transferred",
        "superseded"
      ]
    },
    {
      "from": "accepted",
      "to": "executing",
      "label": "execution begins"
    },
    {
      "from": "accepted",
      "to": "rejected",
      "label": "deadline or validity passes before execution",
      "reasons": [
        "deadline_exceeded",
        "stale_intent"
      ]
    },
    {
      "from": "accepted",
      "to": "cancelled",
      "label": "cancel, e-stop, safe state, close, reset, transfer, superseded",
      "reasons": [
        "cancelled_by_agent",
        "e_stop",
        "safe_state",
        "session_closed",
        "world_reset",
        "transferred",
        "superseded"
      ]
    },
    {
      "from": "executing",
      "to": "completed",
      "label": "goal reached"
    },
    {
      "from": "executing",
      "to": "failed",
      "label": "deadline, e-stop, safe state, envelope, watchdog, error",
      "reasons": [
        "deadline_exceeded",
        "e_stop",
        "connection_lost",
        "envelope",
        "watchdog",
        "world_error"
      ]
    },
    {
      "from": "executing",
