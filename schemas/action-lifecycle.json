      "to": "queued",
      "label": "group busy and preempt is queue"
    },
    {
      "from": "submitted",
      "to": "accepted",
      "label": "admitted"
    },
    {
      "from": "pending_approval",
      "to": "queued",
      "label": "approved and group busy"
    },
    {
      "from": "pending_approval",
      "to": "accepted",
      "label": "approved"
    },
    {
      "from": "pending_approval",
      "to": "rejected",
      "label": "denied, timeout, deadline, re-check fails",
